# Copie este arquivo para .env.local (fica fora do git) e preencha. Reinicie o "npm run dev" depois de mudar.
# Sem chave, o mapa dos treinos usa o OpenStreetMap.

# Chave da Maps JavaScript API (Google Cloud → APIs e serviços → Credenciais).
VITE_GOOGLE_MAPS_API_KEY=

# Opcional: ID de mapa (Google Cloud → Google Maps Platform → Gerenciamento de mapas, tipo JavaScript).
# Sem ele, o app usa o DEMO_MAP_ID do Google, que serve só para testes.
VITE_GOOGLE_MAPS_MAP_ID=
